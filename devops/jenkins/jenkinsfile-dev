pipeline {
    agent any

    environment {
        MAVEN_HOME = tool 'Maven 3.9.9'
        JAVA_HOME = tool 'JDK17'
        DEPLOY_ENV = "dev"
        CONFIG_FILE = "devops/deploy/dev-vars.yaml"
        SONARQUBE = "SonarQube"
        DOCKERHUB_CREDENTIALS = "docker-hub"
    }

    stages {
        stage('Checkout') {
            steps {
                echo " Clonando código fuente..."
                checkout scm
            }
        }

        stage('Load Configuration') {
            steps {
                script {
                    echo " Cargando configuración desde ${CONFIG_FILE}"
                    def vars = readYaml file: CONFIG_FILE
                    env.SONAR_URL = vars.sonar.url
                    env.SONAR_PROJECT_KEY = vars.sonar.projectKey
                    env.DOCKER_IMAGE = "${vars.docker.imageName}:${vars.docker.tag}"
                    env.SKIP_TESTS = vars.build.skipTests.toString()
                    env.ENABLE_JACOCO = vars.build.jacoco.toString()
                    env.ENABLE_CHECKSTYLE = vars.build.checkstyle.toString()
                }
            }
        }

        stage('Clone Dependencies') {
            steps {
                echo " Clonando dependencia dispatch-consumer..."
                dir('../dispatch-consumer') {
                    //  Crea el primer nivel: /dispatch-consumer
                    checkout([$class: 'GitSCM',
                        branches: [[name: '*/develop']],
                        userRemoteConfigs: [[url: 'https://github.com/verdugox/dispatch-consumer.git']]
                    ])
                }
            }
        }

        stage('Start Docker Compose') {
            steps {
                dir('card-ops-producer') { //  docker-compose.yml está aquí
                    script {
                        echo " Limpiando entorno Docker previo..."
                        bat """
                            docker-compose down -v --remove-orphans || exit 0
                            docker container prune -f
                            docker image prune -a -f
                        """

                        echo " Construyendo imágenes sin caché..."
                        bat """
                            docker-compose build --no-cache
                        """

                        echo " Levantando entorno local de dependencias (sin bloqueo del pipeline)..."
                        bat """
                            (
                                docker-compose up -d ^
                                || echo  Advertencia: Falló el docker-compose up, pero el pipeline continuará.
                            ) > docker_compose_log.txt 2>&1 &
                            exit 0
                        """

                        echo " Jenkins continúa sin esperar a Docker Compose."

                    }
                }
            }
        }




        stage('Maven Build & Quality') {
            steps {
                dir('card-ops-producer') {
                    echo " Compilando código con Maven..."
                    bat """
                        "${MAVEN_HOME}\\bin\\mvn" clean verify ^
                        -DskipTests=%SKIP_TESTS% ^
                        -Dcheckstyle.failOnViolation=false
                    """
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                echo " Ejecutando análisis estático con SonarQube..."
                dir('card-ops-producer') {
                    withSonarQubeEnv("${SONARQUBE}") {
                        withCredentials([string(credentialsId: 'sonarqube-token', variable: 'SONAR_TOKEN')]) {
                            bat """
                                "${MAVEN_HOME}\\bin\\mvn" sonar:sonar ^
                                -Dsonar.projectKey=%SONAR_PROJECT_KEY% ^
                                -Dsonar.host.url=%SONAR_URL% ^
                                -Dsonar.login=%SONAR_TOKEN% ^
                                -Dsonar.coverage.jacoco.xmlReportPaths=target/site/jacoco/jacoco.xml ^
                                -Dsonar.java.checkstyle.reportPaths=target/checkstyle-result.xml ^
                                -Dsonar.sources=src/main/java ^
                                -Dsonar.java.binaries=target/classes ^
                                -Dsonar.qualitygate.wait=true
                            """
                        }
                    }
                }
            }
        }


        stage('Docker Build & Push') {
            steps {
                dir('card-ops-producer') {
                    echo " Construyendo imagen Docker local..."
                    bat "docker build -t %DOCKER_IMAGE% ."
                }
                echo " Subiendo imagen a DockerHub..."
                withCredentials([usernamePassword(credentialsId: "${DOCKERHUB_CREDENTIALS}",
                                                 usernameVariable: 'DOCKER_USER',
                                                 passwordVariable: 'DOCKER_PASS')]) {
                    bat """
                        docker login -u %DOCKER_USER% -p %DOCKER_PASS%
                        docker push %DOCKER_IMAGE%
                    """
                }
            }
        }
    }

    post {
        always {
            echo " Publicando reportes de calidad..."
            script {
                //  Publica cobertura JaCoCo
                if (env.ENABLE_JACOCO == "true") {
                    jacoco(
                        execPattern: '**/target/jacoco.exec',
                        classPattern: '**/target/classes',
                        sourcePattern: '**/src/main/java',
                        exclusionPattern: ''
                    )
                }
            }
        }

        success {
            echo " Pipeline completado con éxito. Imagen publicada: ${env.DOCKER_IMAGE}"
        }

        unstable {
            echo " Pipeline marcado como UNSTABLE (hay advertencias de calidad o estilo)."
        }

        failure {
            echo " Pipeline falló. Revisa los logs de Jenkins."
        }
    }
}
