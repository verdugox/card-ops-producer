pipeline {
    agent any

    environment {
        MAVEN_HOME = tool 'Maven 3.9.9'
        JAVA_HOME = tool 'JDK17'
        DEPLOY_ENV = "dev"
        CONFIG_FILE = "devops/deploy/dev-vars.yaml"
        SONARQUBE = "sonarqube-local"
        DOCKERHUB_CREDENTIALS = "dockerhub-cred"
    }

    stages {
        stage('Checkout') {
            steps {
                echo "📦 Clonando código fuente..."
                checkout scm
            }
        }

        stage('Load Configuration') {
            steps {
                script {
                    echo "⚙️ Cargando configuración desde ${CONFIG_FILE}"
                    def vars = readYaml file: CONFIG_FILE
                    env.SONAR_URL = vars.sonar.url
                    env.SONAR_PROJECT_KEY = vars.sonar.projectKey
                    env.DOCKER_IMAGE = "${vars.docker.imageName}:${vars.docker.tag}"
                    env.SKIP_TESTS = vars.build.skipTests.toString()
                    env.ENABLE_JACOCO = vars.build.jacoco.toString()
                    env.ENABLE_CHECKSTYLE = vars.build.checkstyle.toString()
                }
            }
        }

        stage('Start Docker Compose') {
            steps {
                echo "🐳 Levantando entorno local de dependencias (docker-compose)..."
                bat "docker-compose up -d"
            }
        }

        stage('Maven Build & Quality') {
            steps {
                dir('card-ops-producer') {
                    echo "🏗️ Compilando y analizando código (JaCoCo + Checkstyle + Sonar)..."
                    withSonarQubeEnv("${SONARQUBE}") {
                        bat """
                            "${MAVEN_HOME}\\bin\\mvn" clean verify sonar:sonar ^
                            -Dcheckstyle.failOnViolation=false ^
                            -Dsonar.projectKey=%SONAR_PROJECT_KEY% ^
                            -Dsonar.host.url=%SONAR_URL% ^
                            -Dsonar.coverage.jacoco.xmlReportPaths=target/site/jacoco/jacoco.xml ^
                            -Dsonar.java.checkstyle.reportPaths=target/checkstyle-result.xml
                        """
                    }
                }
            }
            post {
                unsuccessful {
                    // Si el build falla, lo marcamos como UNSTABLE en lugar de FAILURE
                    script {
                        currentBuild.result = 'UNSTABLE'
                        echo "⚠️ Build con advertencias, pero continuando pipeline..."
                    }
                }
            }
        }

        stage('Docker Build & Push') {
            steps {
                dir('card-ops-producer') {
                    echo "🐋 Construyendo imagen Docker local..."
                    bat "docker build -t %DOCKER_IMAGE% ."
                }
                echo "📤 Subiendo imagen a DockerHub..."
                withCredentials([usernamePassword(credentialsId: "${DOCKERHUB_CREDENTIALS}",
                                                 usernameVariable: 'DOCKER_USER',
                                                 passwordVariable: 'DOCKER_PASS')]) {
                    bat """
                        docker login -u %DOCKER_USER% -p %DOCKER_PASS%
                        docker push %DOCKER_IMAGE%
                    """
                }
            }
        }

        stage('Cleanup') {
            steps {
                echo "🧹 Deteniendo contenedores y limpiando..."
                bat "docker-compose down"
            }
        }
    }

    post {
        always {
            echo "🧾 Publicando reportes de calidad..."
            script {
                // ✅ Publica cobertura JaCoCo
                if (env.ENABLE_JACOCO == "true") {
                    jacoco(
                        execPattern: '**/target/jacoco.exec',
                        classPattern: '**/target/classes',
                        sourcePattern: '**/src/main/java',
                        exclusionPattern: ''
                    )
                }

                // ✅ Publica resultados de Checkstyle (sin detener build)
                if (env.ENABLE_CHECKSTYLE == "true") {
                    recordIssues(
                        enabledForFailure: true,
                        qualityGates: [[threshold: 1, type: 'TOTAL', unstable: true]],
                        tool: checkStyle(pattern: '**/target/checkstyle-result.xml')
                    )
                }
            }
        }

        success {
            echo "✅ Pipeline completado con éxito. Imagen publicada: ${env.DOCKER_IMAGE}"
        }

        unstable {
            echo "⚠️ Pipeline marcado como UNSTABLE (hay advertencias de calidad o estilo)."
        }

        failure {
            echo "❌ Pipeline falló. Revisa los logs de Jenkins."
        }
    }
}
